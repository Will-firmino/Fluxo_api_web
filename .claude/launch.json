{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api-produto",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd _api_produto && mvn spring-boot:run"],
      "port": 8080
    },
    {
      "name": "my-app-web",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd my-app && BROWSER=none npx expo start --web --port 8081"],
      "port": 8081
    }
  ]
}
